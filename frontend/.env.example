# ---------------------------------------------------------------------------
# Backend base URL used directly by the browser bundle (optional).
# Leave unset to let the app pick a sensible default:
#   - localhost  -> http://localhost:8000/api/v1
#   - deployed   -> /api/v1, proxied to BACKEND_URL by next.config.js
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Where next.config.js proxies /api/v1/* when the app is deployed.
# REQUIRED on your host (Render / Vercel / etc.) so the browser's same-origin
# API calls reach the FastAPI service.
# ---------------------------------------------------------------------------
# BACKEND_URL=https://your-backend.onrender.com
